    {
      "parameters": {
        "jsCode": "const errorData = $input.first().json;\n\n// Extract execution context from error trigger payload\nvar executionData = errorData.execution || {};\nvar executionId = executionData.id || 'N/A';\nvar errorMessage = '';\nif (executionData.error && executionData.error.message) {\n  errorMessage = executionData.error.message;\n} else if (typeof executionData.error === 'string') {\n  errorMessage = executionData.error;\n} else {\n  errorMessage = 'Unknown error';\n}\nvar lastNode = executionData.lastNodeExecuted || 'Unknown';\n\n// Attempt to extract original input parameters from the execution data.\n// The error trigger provides executionData.data.resultData.runData which contains\n// node execution results. The trigger node output has the original parameters.\nvar originalParams = {\n  workflowName: '',\n  aiTaskType: '',\n  originalInput: '',\n  aiOutput: '',\n  aiModel: '',\n  domainContext: '',\n  strictnessThreshold: 80,\n  notifyEmail: '',\n  customValidationInstructions: ''\n};\n\ntry {\n  var runData = executionData.data && executionData.data.resultData && executionData.data.resultData.runData;\n  if (runData) {\n    // Try to get data from the trigger node\n    var triggerData = runData['Sub-Workflow Trigger'];\n    if (triggerData && triggerData[0] && triggerData[0].data && triggerData[0].data.main && triggerData[0].data.main[0]) {\n      var triggerOutput = triggerData[0].data.main[0][0].json;\n      originalParams.workflowName = triggerOutput.workflowName || '';\n      originalParams.aiTaskType = triggerOutput.aiTaskType || '';\n      originalParams.originalInput = triggerOutput.originalInput || '';\n      originalParams.aiOutput = triggerOutput.aiOutput || '';\n      originalParams.aiModel = triggerOutput.aiModel || '';\n      originalParams.domainContext = triggerOutput.domainContext || '';\n      originalParams.strictnessThreshold = triggerOutput.strictnessThreshold || 80;\n      originalParams.notifyEmail = triggerOutput.notifyEmail || '';\n      originalParams.customValidationInstructions = triggerOutput.customValidationInstructions || '';\n    }\n    // If trigger didn't have it, try Prepare Validation Context\n    if (!originalParams.workflowName) {\n      var prepData = runData['Prepare Validation Context'];\n      if (prepData && prepData[0] && prepData[0].data && prepData[0].data.main && prepData[0].data.main[0]) {\n        var prepOutput = prepData[0].data.main[0][0].json;\n        originalParams.workflowName = prepOutput.workflowName || '';\n        originalParams.aiTaskType = prepOutput.aiTaskType || '';\n        originalParams.originalInput = prepOutput.originalInput || '';\n        originalParams.aiOutput = prepOutput.aiOutput || '';\n        originalParams.aiModel = prepOutput.aiModel || '';\n        originalParams.domainContext = prepOutput.domainContext || '';\n        originalParams.strictnessThreshold = prepOutput.strictnessThreshold || 80;\n        originalParams.notifyEmail = prepOutput.notifyEmail || '';\n        originalParams.customValidationInstructions = prepOutput.customValidationInstructions || '';\n      }\n    }\n  }\n} catch (e) {\n  // If we can't extract params, we'll log what we have\n  errorMessage += ' | Parameter extraction failed: ' + e.message;\n}\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    originalExecutionId: executionId,\n    workflowName: originalParams.workflowName || 'Unknown',\n    status: 'PENDING',\n    retryCount: 0,\n    lastRetry: '',\n    errorMessage: errorMessage,\n    lastNode: lastNode,\n    // Original parameters for retry\n    paramWorkflowName: originalParams.workflowName,\n    paramAiTaskType: originalParams.aiTaskType,\n    paramOriginalInput: originalParams.originalInput,\n    paramAiOutput: originalParams.aiOutput,\n    paramAiModel: originalParams.aiModel,\n    paramDomainContext: originalParams.domainContext,\n    paramStrictnessThreshold: originalParams.strictnessThreshold,\n    paramNotifyEmail: originalParams.notifyEmail,\n    paramCustomValidationInstructions: originalParams.customValidationInstructions\n  }\n}];"
      },
