        "jsCode": "const retryItem = $('Loop Items').first().json;\nconst subResult = $input.first().json;\n\nvar currentRetryCount = parseInt(retryItem['Retry Count'] || retryItem.retryCount || 0) + 1;\nvar originalExecutionId = retryItem['Original Execution ID'] || retryItem.originalExecutionId || '';\nvar notifyEmail = retryItem.notifyEmail || retryItem.paramNotifyEmail || '';\nvar workflowName = retryItem['Workflow Name'] || retryItem.workflowName || '';\n\n// Check if the sub-workflow succeeded\nvar succeeded = false;\nif (subResult && subResult.confidenceScore != null && !subResult.error) {\n  succeeded = true;\n}\n\nvar newStatus;\nvar needsEscalation = false;\nif (succeeded) {\n  newStatus = 'RESOLVED';\n} else if (currentRetryCount >= 3) {\n  newStatus = 'FAILED_PERMANENT';\n  needsEscalation = true;\n} else {\n  newStatus = 'PENDING';\n}\n\nreturn [{\n  json: {\n    originalExecutionId: originalExecutionId,\n    status: newStatus,\n    retryCount: currentRetryCount,\n    lastRetry: new Date().toISOString(),\n    needsEscalation: needsEscalation,\n    notifyEmail: notifyEmail,\n    workflowName: workflowName\n  }\n}];"
