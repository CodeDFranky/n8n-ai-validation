      "parameters": {
        "jsCode": "const query = $input.first().json.query || {};\nconst executionId = query.executionId || 'UNKNOWN';\nconst disposition = query.disposition || 'Confirmed OK';\n\nconst checked = function(val, target) {\n  return val === target ? 'checked' : '';\n};\n\nconst html = '<!DOCTYPE html>' +\n'<html>' +\n'<head>' +\n'  <meta charset=\"utf-8\">' +\n'  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">' +\n'  <title>AI Validation Review</title>' +\n'  <style>' +\n'    body { font-family: Arial, sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; background: #f5f5f5; }' +\n'    .header { background: #1a73e8; color: white; padding: 16px; border-radius: 8px 8px 0 0; }' +\n'    .header h2 { margin: 0; }' +\n'    .exec-id { font-family: monospace; font-size: 13px; opacity: 0.8; margin: 4px 0 0; }' +\n'    .form-body { padding: 20px; border: 1px solid #ddd; border-top: none; border-radius: 0 0 8px 8px; background: white; }' +\n'    label.field-label { display: block; margin-top: 16px; font-weight: bold; font-size: 14px; }' +\n'    input[type=\"text\"], textarea { width: 100%; padding: 10px; margin-top: 6px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; font-size: 14px; }' +\n'    textarea { height: 100px; resize: vertical; }' +\n'    .radio-group { margin-top: 10px; display: flex; gap: 16px; flex-wrap: wrap; }' +\n'    .radio-option { display: flex; align-items: center; gap: 6px; }' +\n'    .radio-option input { margin: 0; }' +\n'    .radio-option label { font-weight: normal; cursor: pointer; }' +\n'    button { margin-top: 24px; background: #1a73e8; color: white; border: none; padding: 12px 32px; border-radius: 4px; cursor: pointer; font-size: 16px; font-weight: bold; }' +\n'    button:hover { background: #1557b0; }' +\n'  </style>' +\n'</head>' +\n'<body>' +\n'  <div class=\"header\">' +\n'    <h2>AI Validation Review Response</h2>' +\n'    <p class=\"exec-id\">Execution: ' + executionId + '</p>' +\n'  </div>' +\n'  <div class=\"form-body\">' +\n'    <form method=\"POST\" action=\"\">' +\n'      <input type=\"hidden\" name=\"executionId\" value=\"' + executionId + '\">' +\n'      <label class=\"field-label\">Disposition:</label>' +\n'      <div class=\"radio-group\">' +\n'        <div class=\"radio-option\"><input type=\"radio\" name=\"disposition\" value=\"Confirmed OK\" id=\"d1\" ' + checked(disposition, 'Confirmed OK') + '><label for=\"d1\">Confirmed OK</label></div>' +\n'        <div class=\"radio-option\"><input type=\"radio\" name=\"disposition\" value=\"Corrected\" id=\"d2\" ' + checked(disposition, 'Corrected') + '><label for=\"d2\">Corrected</label></div>' +\n'        <div class=\"radio-option\"><input type=\"radio\" name=\"disposition\" value=\"Escalated\" id=\"d3\" ' + checked(disposition, 'Escalated') + '><label for=\"d3\">Escalated</label></div>' +\n'      </div>' +\n'      <label class=\"field-label\">Reviewed By:</label>' +\n'      <input type=\"text\" name=\"reviewedBy\" placeholder=\"Your name or email\" required>' +\n'      <label class=\"field-label\">Review Notes (optional):</label>' +\n'      <textarea name=\"notes\" placeholder=\"Any notes about this review...\"></textarea>' +\n'      <button type=\"submit\">Submit Review</button>' +\n'    </form>' +\n'  </div>' +\n'</body>' +\n'</html>';\n\nreturn [{ json: { responseBody: html } }];"
      },
